# Mapbox Access Token
# 請至 https://account.mapbox.com/access-tokens/ 申請
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# GIS Platform API URL (選填)
# 指向 gis-platform portal，時刻表從 Supabase 載入
# 範例: https://your-gis-platform.zeabur.app
# VITE_GIS_API_URL=

# 每日時刻表 Base URL (選填，S3 冷備援)
# 當 GIS API 不可用時 fallback 到 S3
# 範例: https://your-data-collectors.zeabur.app/api/mini-taipei
# VITE_DAILY_SCHEDULE_BASE_URL=
