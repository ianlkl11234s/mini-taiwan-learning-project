# Zeabur 快取設定
# 參考: https://zeabur.com/docs/en-US/guides/static

# TRA 大型資料檔案 - 長期快取 (1年)
/data/tra/tracks_od/tracks_od_bundle.json
  Cache-Control: public, max-age=31536000, immutable

/data/tra/schedules_real/master_schedule.json
  Cache-Control: public, max-age=31536000, immutable

/data/tra/tracks_od/od_station_progress.json
  Cache-Control: public, max-age=31536000, immutable

# 其他系統資料 - 中期快取 (1天，允許背景更新)
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# JS/CSS 資源 - 長期快取 (有 hash，可以永久快取)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML - 不快取 (確保載入最新版本)
/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
