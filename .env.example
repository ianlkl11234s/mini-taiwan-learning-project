# Mapbox Access Token
# 請至 https://account.mapbox.com/access-tokens/ 申請
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Supabase 直連 (選填)
# 設定後每日時刻表從 Supabase 載入
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# 每日時刻表 Base URL (選填，S3 冷備援)
# 當 Supabase 不可用時 fallback 到 S3
# VITE_DAILY_SCHEDULE_BASE_URL=

# OpenWeatherMap API Key (選填，天氣模擬用)
# 請至 https://openweathermap.org/api 免費申請
# 未設定時可手動選擇天氣效果
# VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
